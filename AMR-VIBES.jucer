<?xml version="1.0" encoding="UTF-8"?>
<JUCERPROJECT id="AMRVibesAndroid" name="AMR VIBES" projectType="guiapp"
              version="1.0.0" bundleIdentifier="com.angelmusicrecords.amrvibes"
              companyName="Angel Music Records" companyCopyright="Angel Music Records"
              useAppConfig="0" addUsingNamespaceToJuceHeader="1" jucerFormatVersion="1"
              juceFolder="JUCE">
  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android"
                   androidMinimumSDK="24" androidTargetSDK="35"
                   microphonePermissionNeeded="1" androidInternetNeeded="0"
                   androidReadMediaAudioPermission="1" androidExternalWriteNeeded="0"
                   androidVersionCode="1">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" targetName="AMRVibes" recommendedWarnings="LLVM"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="AMRVibes"
                       recommendedWarnings="LLVM" optimisation="3" linkTimeOptimisation="1"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_core" path="JUCE/modules"/>
        <MODULEPATH id="juce_events" path="JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_basics" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils" path="JUCE/modules"/>
      </MODULEPATHS>
    </ANDROIDSTUDIO>
  </EXPORTFORMATS>
  <MAINGROUP name="AMR VIBES" id="AMRVibesGroup">
    <FILE id="MainCpp" name="Main.cpp" compile="1" resource="0" file="Source/Main.cpp"/>
    <FILE id="ProcessorH" name="PluginProcessor.h" compile="0" resource="0" file="Source/PluginProcessor.h"/>
    <FILE id="ProcessorCpp" name="PluginProcessor.cpp" compile="1" resource="0" file="Source/PluginProcessor.cpp"/>
    <FILE id="EditorH" name="PluginEditor.h" compile="0" resource="0" file="Source/PluginEditor.h"/>
    <FILE id="EditorCpp" name="PluginEditor.cpp" compile="1" resource="0" file="Source/PluginEditor.cpp"/>
  </MAINGROUP>
</JUCERPROJECT>
